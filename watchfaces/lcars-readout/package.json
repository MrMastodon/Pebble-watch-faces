{
  "name": "lcars-readout",
  "author": "",
  "version": "0.2.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "LCARS Readout",
    "uuid": "c5b28b21-c964-45e1-89ae-f9dff105b461",
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "health"
    ],
    "messageKeys": [
      "CONDITION",
      "TEMPERATURE"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "BACKGROUND",
          "file": "images/background.png",
          "memoryFormat": "4BitPalette"
        },
        {
          "type": "font",
          "name": "FONT_ANTONIO_58",
          "file": "fonts/Antonio-Bold.ttf",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "FONT_ANTONIO_30",
          "file": "fonts/Antonio-Bold.ttf",
          "characterRegex": "[0-9.]"
        },
        {
          "type": "font",
          "name": "FONT_ANTONIO_22",
          "file": "fonts/Antonio-Bold.ttf",
          "characterRegex": "[0-9A-Z%\u00b0.:?-]"
        },
        {
          "type": "font",
          "name": "FONT_ANTONIO_16",
          "file": "fonts/Antonio-Bold.ttf",
          "characterRegex": "[0-9%LINK]"
        },
        {
          "type": "bitmap",
          "name": "ICON_CLEAR",
          "file": "images/icon_clear.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_CLOUD",
          "file": "images/icon_cloud.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_RAIN",
          "file": "images/icon_rain.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_SNOW",
          "file": "images/icon_snow.png"
        }
      ]
    }
  }
}
